@page
@model MassLab.Identity.Web.Pages.Administration.LoginProvidersModel
@using Microsoft.AspNetCore.Mvc.Localization
@using MassLab.Identity.Localization
@inject IHtmlLocalizer<IdentityResource> L

<h2>@L["LoginProviders"]</h2>

<form method="post">
    <abp-row>
        <abp-column size-md="_6">
            <abp-card>
                <abp-card-header>
                    <abp-card-title>@L["LoginProviders:Google"]</abp-card-title>
                </abp-card-header>
                <abp-card-body>
                    <abp-input asp-for="Google.Enabled" />
                    <abp-input asp-for="Google.ClientId" />
                    <abp-input asp-for="Google.ClientSecret" placeholder="@L["LoginProviders:SecretPlaceholder"]" />
                    <div class="mb-3">
                        <label class="form-label">@L["LoginProviders:CallbackUrl"]</label>
                        <input class="form-control" value="@Model.GoogleCallbackUrl" readonly />
                    </div>
                </abp-card-body>
            </abp-card>
        </abp-column>
        <abp-column size-md="_6">
            <abp-card>
                <abp-card-header>
                    <abp-card-title>@L["LoginProviders:EntraId"]</abp-card-title>
                </abp-card-header>
                <abp-card-body>
                    <abp-input asp-for="EntraId.Enabled" />
                    <abp-input asp-for="EntraId.TenantId" />
                    <abp-input asp-for="EntraId.ClientId" />
                    <abp-input asp-for="EntraId.ClientSecret" placeholder="@L["LoginProviders:SecretPlaceholder"]" />
                    <div class="mb-3">
                        <label class="form-label">@L["LoginProviders:CallbackUrl"]</label>
                        <input class="form-control" value="@Model.EntraIdCallbackUrl" readonly />
                    </div>
                </abp-card-body>
            </abp-card>
        </abp-column>
    </abp-row>
    <abp-button button-type="Primary" type="submit" class="mt-3">@L["LoginProviders:Save"]</abp-button>
</form>
