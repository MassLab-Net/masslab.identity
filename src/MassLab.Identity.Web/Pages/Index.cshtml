@page
@model MassLab.Identity.Web.Pages.IndexModel
@using MassLab.Identity.Web.Menus
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@using Microsoft.AspNetCore.Mvc.Localization
@using MassLab.Identity.Localization
@using Volo.Abp.Users
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<IdentityResource> L
@inject ICurrentUser CurrentUser
@{
    PageLayout.Content.Title = L["Menu:Home"].Value;
    PageLayout.Content.BreadCrumb.ShowCurrent = false;
    PageLayout.Content.ShowToolbar = false;
    PageLayout.Content.MenuItemName = IdentityMenus.Home;
}

@section styles {
    <abp-style src="/Pages/Index.css" />
}

<div class="MassLab-identity-home">
    <section class="MassLab-hero card">
        <div class="card-body">
            <div class="MassLab-hero-content">
                <span class="MassLab-kicker">MassLab Identity</span>
                <h1>@L["Welcome"]</h1>
                <p>@L["LongWelcomeMessage"]</p>
                <div class="MassLab-actions">
                    @if (!CurrentUser.IsAuthenticated)
                    {
                        <a href="/Account/Login" class="btn btn-primary">
                            <i class="fa-solid fa-right-to-bracket me-1"></i>
                            <span>@L["Login"]</span>
                        </a>
                    }
                    <a href="http://localhost:5174/" class="btn btn-outline-primary">
                        Open Admin Portal
                    </a>
                </div>
            </div>
            <div class="MassLab-hero-panel">
                <div class="MassLab-logo">V</div>
                <strong>Identity Service</strong>
                <span>Authentication, authorization, roles, and service permissions.</span>
            </div>
        </div>
    </section>

    <section class="MassLab-grid">
        <article class="card MassLab-card">
            <div class="card-body">
                <span class="MassLab-card-icon"><i class="fa-solid fa-users"></i></span>
                <h3>User Management</h3>
                <p>Manage operator accounts, profile data, activation state, and assigned roles.</p>
            </div>
        </article>
        <article class="card MassLab-card">
            <div class="card-body">
                <span class="MassLab-card-icon"><i class="fa-solid fa-shield-halved"></i></span>
                <h3>Roles & Permissions</h3>
                <p>Grant MassLab service permissions for orders, products, inventory, and settings.</p>
            </div>
        </article>
        <article class="card MassLab-card">
            <div class="card-body">
                <span class="MassLab-card-icon"><i class="fa-solid fa-key"></i></span>
                <h3>OpenID Connect</h3>
                <p>Issue secure tokens for the admin portal and backend service authorization.</p>
            </div>
        </article>
    </section>
</div>
